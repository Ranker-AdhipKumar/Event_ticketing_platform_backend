# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Supported DB_CLIENT: 'sqlite' (zero setup, built-in) or 'postgres'
DB_CLIENT=sqlite
SQLITE_DB_PATH=./data/tickets.db

# If using PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_ticketing_db

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_chars_min!
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_chars_min!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis Configuration (Optional - falls back to memory cache & memory rate limiter)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Booking Rate Limiting
BOOKING_RATE_LIMIT_WINDOW_MS=60000
BOOKING_RATE_LIMIT_MAX=5

# Cancellation Policy
# Hours before event start time within which an attendee can cancel a booking
CANCELLATION_WINDOW_HOURS=24

# SMTP / Email Configuration (Optional - logs to console / outbox in test/dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@eventticketing.example.com
